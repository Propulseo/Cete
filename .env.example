# URL publique du site (SEO : robots, sitemap, metadata)
NEXT_PUBLIC_SITE_URL=https://cete-notation.fr

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx
# Clé service-role : SERVER-ONLY, ne JAMAIS exposer côté client.
# Requise pour l'administration des comptes (auth.admin.createUser, etc.) en B4.
SUPABASE_SERVICE_ROLE_KEY=

# Brevo — email transactionnel (serveur uniquement, ne jamais préfixer NEXT_PUBLIC_)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=
CONTACT_NOTIFICATION_TO=
# Id numérique de la liste de contacts Brevo dédiée à la newsletter du blog
BREVO_NEWSLETTER_LIST_ID=
