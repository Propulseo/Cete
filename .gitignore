# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# artefacts de session locaux (ne jamais deployer)
# NB: .planning/{PROJECT,ROADMAP,REQUIREMENTS,STATE}.md et config.json sont
# volontairement versionnes — seul l'etat de session local est ignore.
/.planning/SESSION.md
/.playwright-mcp/

# scratch / sources d'assets non destinees a la prod
/c.js
/photo denis.jpeg
/footer-before-desktop.png

# Skills agent installes en local (depot public — tooling hors depot)
/.agents/
/.claude/skills/
/skills-lock.json

# Livrables d'audit go-live — VOLONTAIREMENT HORS DEPOT.
# Ce depot est PUBLIC : ces documents detaillent des failles non encore
# corrigees (identifiants de demo, garde de route, conformite legale) et ne
# doivent pas etre publies tant qu'elles sont ouvertes.
# Ils existent en local : docs/go-live-audit.md et docs/go-live-plan.md.
# A reversibiliser si le depot passe en prive.
/docs/go-live-audit.md
/docs/go-live-plan.md

# Audit SEO/GEO — même politique : hors depot tant que les failles sont ouvertes
/docs/seo-geo-audit-2026-07-29.md
/docs/seo-geo-audit-2026-07-29-findings.md

# Audit « matiere premiere pour plateforme tierce » — meme politique : il
# recense en clair les identifiants de demo et les failles encore ouvertes.
/AUDIT-CETE-POUR-PLATEFORME.md
